# Biến môi trường cho CHẠY TEST (node --test).
# Test dùng DB riêng `vimart_test` — test/setup.mjs sẽ TỪ CHỐI chạy nếu
# DATABASE_URL không trỏ tới `vimart_test` (tránh xóa nhầm dữ liệu dev).
#
# Makefile/CI tự đặt các biến này; file này chỉ để tham khảo.
NODE_ENV=test
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vimart_test
JWT_SECRET=test-secret

# ==== Server ====
PORT=4100
NODE_ENV=development
# URL gốc của backend (dùng cho link ảnh, callback...)
API_BASE_URL=http://localhost:4100

# ==== Database (PostgreSQL) ====
# Trên máy local (macOS + Homebrew) thường không cần password.
DATABASE_URL=postgres://macsos@localhost:5432/vimart

# ==== JWT (mã đăng nhập) ====
JWT_SECRET=doi-secret-nay-thanh-chuoi-ngau-nhien-dai
JWT_EXPIRES_IN=7d

# ==== VNPay (thanh toán thử - sandbox) ====
# Đăng ký sandbox tại https://sandbox.vnpayment.vn để lấy mã thật.
VNP_TMN_CODE=YOUR_TMN_CODE
VNP_HASH_SECRET=YOUR_HASH_SECRET
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Người dùng thanh toán xong VNPay sẽ chuyển về link này:
VNP_RETURN_URL=http://localhost:4100/api/payments/vnpay/return

# ==== Cloudinary (ảnh sản phẩm - tùy chọn) ====
# Nếu bỏ trống, ảnh chỉ lưu dạng URL do người dùng nhập.
CLOUDINARY_URL=
